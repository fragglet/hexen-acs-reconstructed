// Script 7 is invoked when the player is in the room behind the eastern door,
// and walks up to the window that looks out on the icy area where the portal
// is. It only triggers once the Chaos Serpents in the area have been killed.
// Oddly, a bunch of wall torches are also configured to start the script.
script 7 (void)
{
    if (thingcount(T_DEMON, 23) == 0)
    {
        clearlinespecial();
        Thing_Activate(const:10);
        Light_Fade(const:63, 176, 35);
        Thing_Deactivate(const:11);
        Light_Fade(const:70, 96, 35);
        Floor_LowerByValue(const:14, 16, 188);
        tagwait(const:14);
        delay(const:70);
        Stairs_BuildDownSync(const:15, 8, 24, 0);
        tagwait(const:15);
        delay(const:70);
        ACS_Execute(const:21, 0, 0, 0, 0);
        delay(const:300);
        Floor_RaiseAndCrush(const:17, 64, 100);
        tagwait(const:17);
        setlinetexture(5, SIDE_FRONT, TEXTURE_MIDDLE, "tportx");
        setlinetexture(6, SIDE_FRONT, TEXTURE_MIDDLE, "tport1");
        setlinespecial(6, 74 /*Teleport_NewMap*/, 3, 0, 0, 0, 0);
        sectorsound("ThunderCrash", 127);
        Light_Fade(const:85, 0, 5);
    }
}

