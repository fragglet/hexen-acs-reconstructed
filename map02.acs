// Script 26 runs at the start of the map and shows the Korax face animation
// and voice: "Greetings, mortal. Are you ready to die?"
script 26 OPEN
{
    if (gametype() != GAME_NET_DEATHMATCH)
    {
        delay(const:30);
        setlinetexture(25, SIDE_FRONT, TEXTURE_MIDDLE, "PRTL07");
        delay(const:70);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC05");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC06");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC07");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC08");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC09");
        delay(const:5);
        print(s:"GREETINGS, MORTAL");
        ambientsound("KoraxVoiceGreetings", 127);
        delay(const:70);
        print(s:"ARE YOU READY TO DIE?");
        ambientsound("KoraxVoiceReady", 127);
        delay(const:70);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC08");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC07");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC06");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC05");
        delay(const:5);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "X_FAC01");
        delay(const:140);
        setlinetexture(26, SIDE_FRONT, TEXTURE_MIDDLE, "BLANK");
        setlinetexture(26, SIDE_BACK, TEXTURE_MIDDLE, "BLANK");
        setlinetexture(25, SIDE_FRONT, TEXTURE_MIDDLE, "BLANK");
        setlinetexture(25, SIDE_BACK, TEXTURE_MIDDLE, "BLANK");
        setlineblocking(25, OFF);
    }
}

