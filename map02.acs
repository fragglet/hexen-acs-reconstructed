// Script 200 opens all the doors on startup in deathmatch mode.
script 200 OPEN
{
    if (gametype() != GAME_NET_DEATHMATCH)
    {
        terminate;
    }
    center_switches = 3;
    delay(random(35, 70));
    Polyobj_RotateRight(const:2, 4, 64);
    delay(random(35, 70));
    Polyobj_RotateRight(const:10, 4, 64);
    delay(random(35, 70));
    Polyobj_RotateRight(const:12, 4, 64);
    delay(random(35, 70));
    Polyobj_RotateRight(const:14, 4, 64);
    delay(random(35, 70));
    Polyobj_RotateRight(const:16, 4, 64);
    delay(random(35, 70));
    ACS_Execute(const:16, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:17, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:18, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:19, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:24, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:27, 0, 0, 0, 0);
    delay(random(128, 255));
    ACS_Execute(const:28, 0, 0, 0, 0);
    delay(random(100, 200)*10);
    Polyobj_RotateRight(const:19, 2, 64);
    Polyobj_RotateLeft(const:20, 2, 64);
    delay(const:35);
    Polyobj_RotateRight(const:21, 2, 64);
    Polyobj_RotateLeft(const:22, 2, 64);
    delay(const:35);
    Polyobj_RotateRight(const:23, 2, 64);
    Polyobj_RotateLeft(const:24, 2, 64);
    delay(const:35);
    Polyobj_RotateRight(const:25, 4, 64);
    terminate;
}

// Script 254 plays background ambient sound effects.
script 254 OPEN
{
    int var0;

    delay(random(2, 7)*100);
    var0 = random(1, 4);
    switch (var0)
    {
    case 1:
        ambientsound("Ambient7", random(const:50, 80));
        break;
    case 2:
        ambientsound("Ambient10", random(const:50, 90));
        break;
    case 3:
        ambientsound("Ambient10", random(const:70, 110));
        break;
    case 4:
        ambientsound("Ambient11", random(const:30, 70));
        break;
    }
    restart;
}

