// Script 9 is triggered by three switches in the building in the center of
// the map. Script 10 catches when all three switches have been pressed.
script 9 (void)
{
    center_switches++;
}

// Script 10 checks once a second to see if the three switches in the center
// of the map have been pressed. Once they have, another door opens.
script 10 OPEN
{
    until (center_switches == 3)
    {
        delay(35);
    }
    delay(const:105);
    Polyobj_RotateRight(const:1, 4, 64);
    delay(const:35);
}

