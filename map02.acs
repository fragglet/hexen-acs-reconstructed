// Script 3 implements the switch found behind the north-eastern door. It
// opens the door in the same area that leads to the portal to the Guardian of
// Fire.
script 3 (void)
{
    if (ne_door_portal == 0)
    {
        ne_door_portal = 1;
        Floor_LowerByValue(const:52, 32, 112);
        Thing_Activate(const:8);
        Light_Fade(const:65, 176, 35);
        Thing_Deactivate(const:9);
        Light_Fade(const:66, 96, 35);
        Door_Raise(const:10, 8, 0);
        delay(const:128);
        Floor_RaiseAndCrush(const:11, 64, 100);
        tagwait(const:11);
        setlinetexture(3, SIDE_FRONT, TEXTURE_MIDDLE, "tportx");
        setlinetexture(4, SIDE_FRONT, TEXTURE_MIDDLE, "tport1");
        setlinespecial(4, 74 /*Teleport_NewMap*/, 4, 0, 0, 0, 0);
        sectorsound("ThunderCrash", 127);
        Light_Fade(const:86, 0, 5);
    }
}

