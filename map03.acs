// Script 7 implements the switch at the northernmost point of the map, and
// randomly picks one of the four portals to be the portal back to the main
// hub map (MAP02):
script 7 (void)
{
    int var0;

    floor_portal = random(const:1, 4);
    var0 = 0;
    while (var0 < 5)
    {
        Pillar_Open(45+var0, 16, 56, 56);
        var0++;
    }
    var0 = 0;
    while (var0 < 5)
    {
        Ceiling_CrushRaiseAndStay(45+var0, random(32, 64), 5);
        delay(random(8, 32));
        var0++;
    }
    var0 = 0;
    while (var0 < 5)
    {
        Ceiling_CrushRaiseAndStay(45+var0, random(32, 64), 5);
        delay(random(8, 32));
        var0++;
    }
    if (floor_portal == 1)
    {
        Light_ChangeToValue(const:36, 192);
    }
    else if (floor_portal == 2)
    {
        Light_ChangeToValue(const:37, 192);
    }
    else if (floor_portal == 3)
    {
        Light_ChangeToValue(const:38, 192);
    }
    else if (floor_portal == 4)
    {
        Light_ChangeToValue(const:39, 192);
    }
    if (gametype() != GAME_NET_DEATHMATCH)
    {
        ACS_Execute(const:29, 2, 0, 0, 0);
    }
}

// Script 8 is triggered when the player walks onto one of the four floor
// portals in the northmost room. One of the portals was chosen (by script
// 7 above) to be the portal back to the main hub map; the others are traps
// that kill the player.
script 8 (int arg0, int arg1)
{
    if (floor_portal == arg0)
    {
        Teleport_NewMap(const:2, 1);
    }
    else
    {
        Ceiling_LowerAndCrush(arg1, 200, 100);
    }
}

