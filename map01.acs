// Script 3 performs the fireball attack sequence when a player gets too close
// to the demon faces in the main hall:
script 3 (void)
{
    int var0;

    Polyobj_OR_RotateRight(const:6, 24, 128);
    delay(const:40);
    while (var0 < 18)
    {
        setlinetexture(1, SIDE_FRONT, TEXTURE_MIDDLE, "SPAWN09");
        delay(const:2);
        setlinetexture(1, SIDE_FRONT, TEXTURE_MIDDLE, "SPAWN10");
        Thing_ProjectileGravity(1, T_FIREBALL1, random(32, 96), random(160, 208), 0);
        thingsound(1, "FireDemonAttack", 127);
        delay(const:2);
        setlinetexture(1, SIDE_FRONT, TEXTURE_MIDDLE, "SPAWN08");
        delay(random(2, 8));
        var0++;
    }
    Polyobj_OR_RotateRight(const:6, 24, 128);
}

// Script 4 performs the moving wall sequence that opens up the steps to the
// emerald key room (at the North-West area of the map):
script 4 (void)
{
    int var0;

    delay(const:8);
    while (var0 < 8)
    {
        Polyobj_OR_Move(var0+8, 16, 192, 64);
        delay(const:32);
        var0 += 2;
    }
}

// Script 5 opens a secret doorway in the emerald key room that leads to a
// teleporter that is only accessible in deathmatch mode.
script 5 (void)
{
    if (gametype() == GAME_NET_DEATHMATCH)
    {
        Door_Open(const:90, 16);
    }
}

