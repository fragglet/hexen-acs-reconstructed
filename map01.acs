// Script 7 opens the doors to the four little alcoves surrounding the
// teleporter in the main hall (each contains an Ettin). They are triggered by
// lines surrounding the teleporter if the player gets too close to it.
script 7 (void)
{
    if (alcove_count < 4)
    {
        Floor_MoveToValueTimes8(const:30, 64, 2, FALSE);
        delay(const:256);
        Floor_RaiseAndCrush(const:30, 32, 100);
        alcove_count++;
    }
}

// Script 8 is triggered when the player tries to open the closed door behind
// the emerald key door that leads up to the ramparts.
script 8 (void)
{
    if (ramparts_opened == 0)
    {
        print(s:"THE DOOR IS LOCKED");
    }
}

// Script 9 implements the switch found behind the emerald key door that opens
// the door leading up to the ramparts.
script 9 (void)
{
    Door_Open(const:18, 16);
    ramparts_opened = 1;
}

// Script 10 implements the switch found on top of the ramparts next to the
// emerald key door. It opens the door that leads to the courtyard containing
// the bell tower (southern end of the level)
script 10 (void)
{
    Door_Open(const:14, 16);
    courtyard_opened = 1;
}

