// Script 12 is triggered by the lines surrounding the silver key. It starts
// the moving floors and ceilings that the player must navigate to get back
// to the rest of the level.
script 12 (void)
{
    int var0;
    int var1;

    mapvar3 = 1;
    while (var1 < 20)
    {
        while (var0 < 4)
        {
            Pillar_BuildAndCrush(40+var0, random(const:8, 32), 0, 20);
            tagwait(40+var0);
            Pillar_Open(40+var0, random(const:8, 32), 0, 0);
            var0++;
        }
        var0 = 0;
        var1++;
    }
}

